# Copia este archivo como .env y ajusta los valores. El .env no se sube al repositorio.

# Puerto local. En Render lo asigna la plataforma.
PORT=3000

# Dominios del frontend que pueden llamar a la API, separados por comas.
# Déjalo vacío si el frontend lo sirve este mismo servidor.
# Ejemplo: ORIGEN_FRONTEND=https://atalaya-studio.netlify.app
ORIGEN_FRONTEND=
